{
  "manifest_version": 3,
  "name": "Better Web Insta",
  "version": "2.0.0",
  "description": "Power-user tools across instagram.com, youtube.com, x.com, reddit.com, linkedin.com, and tiktok.com: bulk unfollow/unlike/unsave/withdraw, feed cleanup, hide promoted content, and keyboard shortcuts.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.instagram.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "run_at": "document_idle",
      "js": [
        "src/config.js",
        "src/ig-api.js",
        "src/queue.js",
        "src/ui.js",
        "src/feature1.js",
        "src/feature2.js",
        "src/feature3.js",
        "src/feature4.js",
        "src/feature5.js",
        "src/feature7.js",
        "src/feature9.js"
      ],
      "css": ["styles.css"]
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "run_at": "document_idle",
      "js": [
        "src/config.js",
        "src/queue.js",
        "src/ui.js",
        "src/yt-bulk.js",
        "src/yt-keys.js"
      ],
      "css": ["styles.css"]
    },
    {
      "matches": ["https://x.com/*"],
      "run_at": "document_idle",
      "js": [
        "src/config.js",
        "src/queue.js",
        "src/ui.js",
        "src/x-api.js",
        "src/x-feed.js",
        "src/x-hide.js",
        "src/x-keys.js",
        "src/x-unlike.js",
        "src/x-unfollow.js"
      ],
      "css": ["styles.css"]
    },
    {
      "matches": ["https://*.reddit.com/*"],
      "run_at": "document_idle",
      "js": [
        "src/config.js",
        "src/queue.js",
        "src/ui.js",
        "src/reddit-unsave.js",
        "src/reddit-hide.js"
      ],
      "css": ["styles.css"]
    },
    {
      "matches": ["https://www.linkedin.com/*"],
      "run_at": "document_idle",
      "js": [
        "src/config.js",
        "src/queue.js",
        "src/ui.js",
        "src/linkedin-invites.js",
        "src/linkedin-hide.js"
      ],
      "css": ["styles.css"]
    },
    {
      "matches": ["https://www.tiktok.com/*"],
      "run_at": "document_idle",
      "js": [
        "src/config.js",
        "src/queue.js",
        "src/ui.js",
        "src/tiktok-bulk.js"
      ],
      "css": ["styles.css"]
    }
  ],
  "action": {
    "default_title": "Better Web Insta",
    "default_popup": "popup.html"
  }
}
